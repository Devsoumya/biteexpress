# Host development against `docker compose up -d mongo`.
# URIs are quoted because they contain "&" (needed for `set -a; . ./.env`).
# directConnection=true is required from the host: without it the driver
# follows the replica set's advertised host "mongo", which the host cannot resolve.
PORT=3000
NODE_ENV=development
MONGODB_URI="mongodb://biteexpress:local-dev-only@localhost:27017/biteexpress?authSource=admin&directConnection=true"
TENANT_ID=biteexpress
SEARCH_INDEX_NAME=restaurants_search
QUERY_MAX_TIME_MS=2000
BEST_MIN_VOTES=20
VOCABULARY_REFRESH_MS=86400000
SLOW_REQUEST_MS=500
LOG_LEVEL=info

# Integration tests only. Must name the biteexpress_test database.
TEST_MONGODB_URI="mongodb://biteexpress:local-dev-only@localhost:27017/biteexpress_test?authSource=admin&directConnection=true"

# Docker Compose
MONGO_ROOT_USERNAME=biteexpress
MONGO_ROOT_PASSWORD=local-dev-only
MONGO_PORT=27017
